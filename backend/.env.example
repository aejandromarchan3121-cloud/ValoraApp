# --- General ---
ENV=dev
ALLOWED_ORIGINS=http://localhost:5173,https://valoraapp-sigma.vercel.app

# --- Supabase (la service_role NUNCA va al frontend) ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- On-Ramp: mock (desarrollo) | bridge ---
ONRAMP_PROVIDER=mock
MOCK_WEBHOOK_SECRET=cambia-esto-en-dev
BRIDGE_API_KEY=
BRIDGE_BASE_URL=https://api.bridge.xyz
# Clave pública del webhook (PEM). En una sola línea, usa \n literales.
BRIDGE_WEBHOOK_PUBLIC_KEY=
BRIDGE_DESTINATION_RAIL=base
# Dirección de tesorería (USDC en Base) que recibe los depósitos
TREASURY_ADDRESS=

# --- Recarga simulada con tarjeta (SOLO pruebas; jamás en producción) ---
SANDBOX_TOPUP_ENABLED=false
SANDBOX_TOPUP_MAX_USD=500

# --- Operaciones ---
ADMIN_API_KEY=genera-una-clave-larga-y-aleatoria
MAX_TRANSFER_USD=1000
MAX_WITHDRAW_DAILY_USD=500

# --- IA ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_DAILY_LIMIT=60
